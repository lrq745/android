<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 书名 -->
        <TextView
            android:id="@+id/tv_record_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="图书名称"
            android:textSize="16sp"
            android:textColor="@color/gray_dark"
            android:textStyle="bold" />

        <!-- 读者信息 -->
        <TextView
            android:id="@+id/tv_record_reader_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="读者：张三"
            android:textSize="13sp"
            android:textColor="@color/gray_normal" />

        <TextView
            android:id="@+id/tv_record_reader_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="账号：student1"
            android:textSize="12sp"
            android:textColor="@color/gray_light" />

        <!-- 时间信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_record_borrow_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="借阅：2024-01-15 14:30"
                android:textSize="12sp"
                android:textColor="@color/gray_normal" />

            <TextView
                android:id="@+id/tv_record_due_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="应还：2024-01-29 14:30"
                android:textSize="12sp"
                android:textColor="@color/gray_normal"
                android:gravity="end" />
        </LinearLayout>

        <!-- 逾期天数 -->
        <TextView
            android:id="@+id/tv_overdue_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="已逾期：5 天"
            android:textSize="14sp"
            android:textColor="@android:color/holo_red_dark"
            android:textStyle="bold"
            android:gravity="end" />

        <!-- 确认归还按钮 -->
        <Button
            android:id="@+id/btn_confirm_return"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:layout_gravity="end"
            android:text="确认归还"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="#4CAF50"
            android:paddingHorizontal="24dp"
            android:minWidth="100dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>