<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_bg">

    <!-- 顶部用户信息栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:contentDescription="用户头像" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_reader_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="欢迎，张三"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_reader_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号：student1"
                android:textSize="12sp"
                android:textColor="#E8EAF6" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_reader_logout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="退出"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:backgroundTint="#FF5252"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <!-- 功能按钮区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="32dp">

            <!-- 浏览图书按钮 -->
            <Button
                android:id="@+id/btn_browse_books"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📚 浏览图书"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/colorPrimary"
                android:paddingVertical="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp" />

            <!-- 我的借阅按钮 -->
            <Button
                android:id="@+id/btn_my_borrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 我的借阅"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/colorAccent"
                android:paddingVertical="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp" />

            <!-- 借阅历史按钮 -->
            <Button
                android:id="@+id/btn_borrow_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📖 借阅历史"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:backgroundTint="#607D8B"
                android:paddingVertical="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp" />

            <!-- 当前借阅统计卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        android:contentDescription="借阅统计" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="当前借阅统计"
                            android:textSize="16sp"
                            android:textColor="@color/gray_dark"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_borrow_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="借阅中：0本 | 已归还：0本"
                            android:textSize="13sp"
                            android:textColor="@color/gray_normal" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>